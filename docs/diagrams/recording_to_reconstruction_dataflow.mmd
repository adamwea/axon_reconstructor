flowchart LR
  %% Map raw recording -> templates artifacts -> reconstruction inputs

  h5[Maxwell data.raw.h5]
  stream[stream_id / well]
  mea_root[mea_output_root]

  subgraph RP[raw_preprocessing]
    rp_fn[build_concatenated_recording]
    rp_rec[SpikeInterface Recording\n(concatenated)]
    rp_meta[Recording geometry + properties\n(electrode ids, locations)]
    rp_all[all recorded electrodes\n(dataset-level)]
    rp_common[common_electrodes\n(intersection across segments)]

    h5 --> rp_fn
    stream --> rp_fn
    rp_fn --> rp_rec
    rp_rec --> rp_meta
    rp_meta --> rp_all
    rp_meta --> rp_common
  end

  subgraph SS[spikesorting (MEA_Analysis)]
    ss_driver[MEA_Analysis pipeline\n(run_pipeline_driver.py)]
    ss_out[spikesorting_outputs/\n(sorter_output/ etc)]
    qm[qm_unfiltered.xlsx\n(QM source of truth)]
    curated[curated unit_ids\n(optional selection list)]

    rp_rec --> ss_driver
    stream --> ss_driver
    mea_root --> ss_driver
    ss_driver --> ss_out

    ss_out --> qm
    qm --> curated
  end

  subgraph WF[waveforms (QC only)]
    wf_fn[extract_waveforms]
    wf_sa[SortingAnalyzer(s)\n(waveforms analyzers)]
    wf_plots[waveforms_grid_*.pdf\n(curated vs uncurated)]

    rp_rec --> wf_fn
    ss_out --> wf_fn
    wf_fn --> wf_sa
    wf_fn --> wf_plots
  end

  subgraph TPL[templates]
    tpl_fn[extract_and_merge_templates]

    tpl_merge[merged_contributing template\n(sparse: contributing channels only)]
    tpl_merge_meta[merged_contributing_template_meta.json\n(contains sampling_frequency_hz)]

    tpl_full_dir[full_channels_templates/\n(dense full-channel axis)]
    tpl_full_tmpl[full_template.npy\n(time x full_channels)]
    tpl_full_locs[full_channel_locations_xy.npy\n(full_channels x 2)]
    tpl_unit_sets[per-unit channel sets\ncontributing / non-contributing / quiet]
    tpl_dense_note[dense representation\nquiet+noncontributing => zeros]

    wf_sa --> tpl_fn
    curated -.->|used for curated plots only| tpl_fn

    tpl_fn --> tpl_merge
    tpl_fn --> tpl_merge_meta

    tpl_fn --> tpl_full_dir
    tpl_full_dir --> tpl_full_tmpl
    tpl_full_dir --> tpl_full_locs
    tpl_fn --> tpl_unit_sets
    tpl_unit_sets --> tpl_dense_note
  end

  subgraph RX[reconstruction]
    rx_fn[reconstruct_from_templates]
    av[axon_velocity.compute_graph_propagation_velocity]

    rx_inputs[inputs to axon_velocity\n(template_ch_by_t, locs_xy, fs_hz)]
    rx_out[reconstruction_outputs/\nreconstruction_summary.json\nby_unit/unit_<id>/{branches,heuristics}.json\nall_units_morphology.pdf (optional)]

    rx_fn --> rx_inputs
    rx_inputs --> av
    av --> rx_out
  end

  %% Primary handoff: dense full-channel templates + stable geometry
  tpl_full_tmpl --> rx_fn
  tpl_full_locs --> rx_fn

  %% Best-effort metadata handoff: sampling frequency lives in merged meta
  tpl_merge_meta -.->|fs_hz| rx_fn

  %% Optional selection: pass curated unit_ids into reconstruction inputs
  curated -.->|inputs.unit_ids| rx_fn
