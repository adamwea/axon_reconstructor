flowchart LR
  h5[Maxwell .h5]
  stream[stream_id / well]
  mea_root[mea_output_root]

  subgraph RP[raw_preprocessing]
    rp_fn[build_concatenated_recording]
    h5 --> rp_fn
    stream --> rp_fn

    rp_rec[SpikeInterface recording - concatenated]
    rp_common[common_electrodes]

    rp_fn -->|returns| rp_rec
    rp_fn -->|returns| rp_common

    rp_fn --> rp_layout[channel_layouts/*.png]
    rp_fn --> rp_concatplot[concat_cluster_reps_<stream_id>.png]
    rp_fn --> rp_segtraces[segment_traces/segment_trace_<stream_id>_<rec>.png]
  end

  subgraph SS[spikesorting - MEA_Analysis]
    ss_driver[MEA_Analysis run_pipeline_driver.py]
    rp_rec --> ss_driver
    stream --> ss_driver
    mea_root --> ss_driver

    ss_out[sorter_output/]
    ss_driver --> ss_out
  end

  subgraph WF[waveforms]
    wf_fn[extract_waveforms]
    rp_rec --> wf_fn
    ss_out --> wf_fn

    wf_fn --> wf_pdf1[waveforms_grid_uncurated.pdf]
    wf_fn --> wf_pdf2[waveforms_grid_curated.pdf optional]
  end

  subgraph TPL[templates]
    tpl_fn[extract_and_merge_templates]
    wf_fn --> tpl_fn

    tpl_merged[merged_union templates]
    tpl_fn --> tpl_merged

    tpl_fn --> tpl_pdf1[templates_grid_uncurated.pdf]
    tpl_fn --> tpl_pdf2[templates_grid_curated.pdf]
    tpl_fn --> tpl_ms1[multi_source_by_unit/*.pdf optional]
    tpl_fn --> tpl_ms2[multi_source_by_unit_uncurated/*.pdf optional]
  end

  subgraph FP[footprinting]
    fp_fn[run_footprinting]
    wf_fn --> fp_fn

    fp_fn --> fp_pdf1[footprints_grid_concat.pdf]
    fp_fn --> fp_pdf2[footprints_grid_concat_curated.pdf]
    fp_fn --> fp_pdf3[footprints_by_source/*.pdf optional]
    fp_fn --> fp_pdf4[footprints_by_source_uncurated/*.pdf optional]
    fp_fn --> fp_pdf5[merged_union_by_unit/*.pdf optional]
    fp_fn --> fp_pdf6[merged_union_by_unit_uncurated/*.pdf optional]
  end

  subgraph RX[reconstruction]
    rx_fn[reconstruct_from_templates]
    tpl_merged --> rx_fn

    rx_fn --> rx_pdf_all[all_units_morphology.pdf optional]
    rx_fn --> rx_by_unit[by_unit/unit_<id>/*.pdf]
  end
