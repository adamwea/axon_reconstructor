# Project-local defaults for canonical axon_reconstructor CLI.
#
# Usage:
#   python -m axon_reconstructor.cli stage preprocess --env-file ./project.env
#   python -m axon_reconstructor.cli scope-run --config ./scope_config.json --env-file ./project.env
#
# Precedence:
#   CLI flags > shell environment > this env file > command defaults

# Required for stage execution unless provided as CLI flags.
AXON_RECON_H5_PATH=/path/to/data.raw.h5
AXON_RECON_STREAM_ID=well003
AXON_RECON_MEA_OUTPUT_ROOT=/path/to/outputs

# Required for spikesort stage (unless provided with --mea-analysis-repo-root).
AXON_RECON_MEA_ANALYSIS_REPO_ROOT=/path/to/MEA_Analysis

# Common runtime defaults.
AXON_RECON_SORTER=kilosort4
AXON_RECON_N_JOBS=8
AXON_RECON_CHUNK_DURATION=1s
AXON_RECON_FORCE_RESTART=0
AXON_RECON_DEBUG=0

# Optional stage diagnostics.
AXON_RECON_BREAK_BEFORE_RUN=0
AXON_RECON_WF_DEBUG_MAX_UNITS=
AXON_RECON_WF_DEBUG_MAX_SEGMENTS=
