# Example debug environment for axon_reconstructor tools/debug scripts.
# Copy this file, edit values, then pass with --env-file.

# --- Paths (required) ---
AXON_RECON_H5_PATH=/abs/path/to/data.raw.h5
AXON_RECON_STREAM_ID=well000
AXON_RECON_MEA_OUTPUT_ROOT=/abs/path/to/outputs

# Optional repo roots if not installed as packages
AXON_RECON_MEA_ANALYSIS_REPO_ROOT=/abs/path/to/MEA_Analysis
AXON_RECON_AXON_VELOCITY_REPO_ROOT=/abs/path/to/axon_velocity

# --- Global toggles ---
AXON_RECON_DEBUG=0
AXON_RECON_FORCE_RESTART=0
AXON_RECON_FORCE_REPLOT=0
AXON_RECON_BREAK_BEFORE_RUN=0

# --- Cross-well analysis ---
AXON_RECON_CROSS_WELL_PLOT_SOURCES=both
AXON_RECON_CROSS_WELL_EXCLUDE_OUTLIERS_IN_TESTS=1
AXON_RECON_CROSS_WELL_OUTLIER_IQR_K=1.5

# --- Unit selection ---
AXON_RECON_UNIT_LIMIT=none
# AXON_RECON_UNIT_IDS=128

# --- Preprocessing ---
AXON_RECON_N_JOBS=4

# --- Spikesorting ---
AXON_RECON_SORTER=kilosort4
AXON_RECON_DOCKER_IMAGE=adammwea/benshalomlab_spikesorter_pythonpatch:v3
AXON_RECON_SPIKESORT_RERUN_ANALYZER=0
AXON_RECON_SPIKESORT_AUTO_MERGE_UNITS=1
AXON_RECON_SPIKESORT_AUTO_MERGE_TEMPLATE_DIFF_THRESH=0.05,0.15,0.25
AXON_RECON_SPIKESORT_CURATION=1

# Thread/resource knobs
AXON_RECON_CHUNK_DURATION=1s
AXON_RECON_TORCH_THREADS=1
AXON_RECON_TORCH_INTEROP_THREADS=1
AXON_RECON_OMP_THREADS=1
AXON_RECON_MKL_THREADS=1
AXON_RECON_OPENBLAS_THREADS=1
AXON_RECON_NUMEXPR_THREADS=1
AXON_RECON_KS_BATCH_DURATION_S=0.75

# --- Waveforms ---
AXON_RECON_WF_MS_BEFORE=1
AXON_RECON_WF_MS_AFTER=2
AXON_RECON_WF_MAX_SPIKES_PER_UNIT=1000000
AXON_RECON_WF_PER_SEGMENT=1
AXON_RECON_WF_FILTER_BY_MAXWELL_EPOCHS=1
AXON_RECON_WF_DEBUG_MAX_UNITS=
AXON_RECON_WF_DEBUG_MAX_SEGMENTS=

# --- Templates ---
AXON_RECON_INCLUDE_CONCAT=1
AXON_RECON_INCLUDE_SEGMENTS=1
AXON_RECON_FOOTPRINT_UNIT_LIMIT=1000
AXON_RECON_FOOTPRINT_PLOT_CONCAT_GRID=1
AXON_RECON_FOOTPRINT_PLOT_MULTI_SOURCE=1
AXON_RECON_TEMPLATES_UNIT_LIMIT=none
AXON_RECON_TEMPLATES_TOP_CHANNELS_PER_TEMPLATE=0
AXON_RECON_TEMPLATES_PLOT_GRID_PDF=1
AXON_RECON_TEMPLATES_PLOT_MULTI_SOURCE_PDF=1
AXON_RECON_TEMPLATES_REPLOT_FROM_DISK=0
AXON_RECON_TEMPLATES_TIME_UPSAMPLE_FACTOR=10
AXON_RECON_TEMPLATES_TIME_UPSAMPLE_METHOD=sinc
AXON_RECON_TEMPLATES_REQUIRE_CURATED_UNITS=1

# --- Reconstruction ---
AXON_RECON_RECON_UNIT_LIMIT=1000
AXON_RECON_RECON_WRITE_UNIT_PDFS=1
AXON_RECON_RECON_WRITE_ALL_UNITS_OVERVIEW_PDF=1
AXON_RECON_RECON_VERBOSE=0
AXON_RECON_RECON_WRITE_TEMPLATE_MOVIE_GIF=1

# --- AV (axon_velocity) overrides (optional) ---
AXON_RECON_AV_MIN_POINTS_AFTER_BRANCHING=2
AXON_RECON_AV_MIN_PATH_LENGTH=17.5
AXON_RECON_AV_MIN_PATH_POINTS=4
AXON_RECON_AV_MAX_PEAK_LATENCY_FOR_SPLITTING=0.5
AXON_RECON_AV_KURT_THRESHOLD=0.25
AXON_RECON_AV_N_NEIGHBORS=8
AXON_RECON_AV_DISTANCE_EXP=1
AXON_RECON_AV_REMOVE_ISOLATED=false
AXON_RECON_AV_DETECT_THRESHOLD=0.005
AXON_RECON_AV_MIN_SELECTED_POINTS=25
AXON_RECON_AV_MAD_THRESHOLD=10
AXON_RECON_AV_MIN_OUTLIER_TRACKING_ERROR=200
AXON_RECON_AV_NEIGHBOR_RADIUS=50
AXON_RECON_AV_SPLIT_PATHS=true
AXON_RECON_AV_THEILSEN_MAXITER=8000

# --- Analysis ---
AXON_RECON_ANALYSIS_PREFER_CURATED_WAVEFORMS_PANELS=1
AXON_RECON_ANALYSIS_BOTM_ENABLE=0
AXON_RECON_ANALYSIS_BOTM_N_SPIKE=200
