{
  "mea_output_root": "/path/to/outputs",
  "mea_analysis_repo_root": "/path/to/MEA_Analysis",
  "sorter": "kilosort4",
  "docker_image": "adammwea/benshalomlab_spikesorter_pythonpatch:v3",
  "n_jobs": 8,
  "chunk_duration": "1s",
  "force_restart": false,
  "per_well_parallelism": 2,
  "fail_fast": true,
  "stage_order": [
    "preprocess",
    "spikesort",
    "waveforms",
    "templates",
    "reconstruct",
    "analysis"
  ],
  "stage_kwargs": {
    "reconstruct": {
      "unit_workers": 2,
      "write_unit_pdfs": false,
      "write_all_units_overview_pdf": false
    }
  },
  "datasets": [
    {
      "dataset_id": "dataset_001",
      "h5_path": "/path/to/data.raw.h5",
      "wells": [
        {
          "stream_id": "well001"
        },
        {
          "stream_id": "well003"
        }
      ]
    }
  ]
}