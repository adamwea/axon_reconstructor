#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: axon-recon-container [wrapper-options] <axon-reconstructor-args...>

Wrapper options:
  --image IMAGE          Container image to run (default: AXON_RECON_CONTAINER_IMAGE or axon-recon:local)
  --dry-run              Print the resolved docker command without running it
  --repo-root PATH       Repo root to mount (default: git top-level or this script's parent)
  --repo-writable        Mount the repo read-write instead of read-only
  --cache-dir PATH       Host cache directory (default: ~/.cache/axon-recon-container)
  --user SPEC            Run the container as a Docker user spec (for example UID:GID)
  --current-user         Run the container as the current host UID:GID
  --no-config-mounts     Do not inspect --config to add data/output/scratch mounts
  --mount SPEC           Extra docker -v mount, repeatable (host:container[:mode])
  --env SPEC             Extra docker -e env var, repeatable (NAME=VALUE)
  --no-tty               Do not allocate an interactive TTY
  --wrapper-help         Show this help

All remaining arguments are passed unchanged to axon-reconstructor inside the image.
EOF
}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root=""
if git rev-parse --show-toplevel >/dev/null 2>&1; then
  git_prefix="$(git rev-parse --show-prefix)"
  if [[ -n "$git_prefix" ]]; then
    repo_root="${PWD%/${git_prefix%/}}"
  else
    repo_root="$PWD"
  fi
elif git_root="$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null)"; then
  repo_root="$git_root"
else
  repo_root="$(cd "$script_dir/.." && pwd)"
fi

container_cli="${AXON_RECON_CONTAINER_CLI:-docker}"
image="${AXON_RECON_CONTAINER_IMAGE:-axon-recon:local}"
cache_dir="${AXON_RECON_CONTAINER_CACHE:-${HOME}/.cache/axon-recon-container}"
container_user="${AXON_RECON_CONTAINER_USER:-}"
config_mounts="${AXON_RECON_CONTAINER_CONFIG_MOUNTS:-1}"
repo_mode="ro"
dry_run=0
tty=1
extra_mounts=()
auto_mounts=()
extra_env=()

find_cli_config_path() {
  local arg
  local -a cli_args=("$@")
  local i
  for ((i = 0; i < ${#cli_args[@]}; i++)); do
  arg="${cli_args[$i]}"
  if [[ "$arg" == "--config" ]]; then
    if ((i + 1 >= ${#cli_args[@]})); then
    echo "axon-recon-container: --config requires a value" >&2
    return 2
    fi
    printf '%s\n' "${cli_args[$((i + 1))]}"
    return 0
  fi
  if [[ "$arg" == --config=* ]]; then
    printf '%s\n' "${arg#--config=}"
    return 0
  fi
  done
}

resolve_config_mounts() {
  local config_path="$1"
  if ! command -v python3 >/dev/null 2>&1; then
  echo "axon-recon-container: python3 is required for config-derived mounts; pass --no-config-mounts or explicit --mount flags" >&2
  return 69
  fi
  python3 - "$repo_root" "$config_path" <<'PY'
from __future__ import annotations

import os
import re
import sys
from pathlib import Path

repo_root = Path(os.path.expandvars(os.path.expanduser(sys.argv[1]))).resolve()
config_path = Path(os.path.expandvars(os.path.expanduser(sys.argv[2])))
if not config_path.is_absolute():
  config_path = Path.cwd() / config_path
config_path = config_path.resolve()


def fail(message: str, code: int = 66) -> None:
  print(f"axon-recon-container: {message}", file=sys.stderr)
  raise SystemExit(code)


def clean_value(raw: str) -> str | None:
  value = raw.split("#", 1)[0].strip()
  if len(value) >= 2 and value[0] == value[-1] and value[0] in {'"', "'"}:
    value = value[1:-1]
  if value in {"", "null", "None", "~"}:
    return None
  return value


def scalar_values(path: Path, key: str) -> list[str]:
  pattern = re.compile(rf"^\s*(?:-\s*)?{re.escape(key)}\s*:\s*(.*?)\s*$")
  values: list[str] = []
  try:
    lines = path.read_text(encoding="utf-8").splitlines()
  except OSError as exc:
    fail(f"cannot read config file {path}: {exc}")
  for line in lines:
    if line.lstrip().startswith("#"):
      continue
    match = pattern.match(line)
    if match is None:
      continue
    value = clean_value(match.group(1))
    if value is not None:
      values.append(value)
  return values


def resolve_path(raw: str, base: Path) -> Path:
  path = Path(os.path.expandvars(os.path.expanduser(raw)))
  if not path.is_absolute():
    path = base / path
  return path.resolve()


def is_under(path: Path, parent: Path) -> bool:
  try:
    path.relative_to(parent)
    return True
  except ValueError:
    return False


mounts: list[tuple[Path, str, str]] = []


def add_mount(path: Path, mode: str, label: str) -> None:
  path = path.resolve()
  if is_under(path, repo_root):
    return
  if mode == "ro" and not path.exists():
    fail(f"required {label} path does not exist: {path}")
  if mode == "rw":
    try:
      path.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
      fail(f"cannot create writable {label} path {path}: {exc}", code=73)
  for existing, existing_mode, _ in mounts:
    if path == existing and mode == existing_mode:
      return
  mounts.append((path, mode, label))


if not config_path.exists():
  fail(f"--config path does not exist: {config_path}")

add_mount(config_path.parent, "ro", "runtime config directory")
data_values = scalar_values(config_path, "data")
data_path: Path | None = None
if data_values:
  data_path = resolve_path(data_values[0], config_path.parent)
  add_mount(data_path.parent, "ro", "data config directory")

if data_path is not None and data_path.exists():
  data_base = data_path.parent
  for key in ("output_root", "output_root_2"):
    for raw in scalar_values(data_path, key):
      add_mount(resolve_path(raw, data_base), "rw", key)
  for raw in scalar_values(data_path, "scratch_root"):
    add_mount(resolve_path(raw, data_base), "rw", "scratch_root")
  raw_parent_paths = [resolve_path(raw, data_base).parent for raw in scalar_values(data_path, "raw_data_h5_path")]
  if raw_parent_paths:
    raw_common = Path(os.path.commonpath([str(path) for path in raw_parent_paths]))
    if str(raw_common) in {"/", "/mnt", "/home"}:
      for raw_parent in raw_parent_paths:
        add_mount(raw_parent, "ro", "raw_data_h5_path parent")
    else:
      add_mount(raw_common, "ro", "raw_data_h5_path common root")

for path, mode, _label in sorted(mounts, key=lambda item: str(item[0])):
  print(f"{path}:{path}:{mode}")
PY
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --image)
      image="${2:?--image requires a value}"
      shift 2
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    --repo-root)
      repo_root="$(cd "${2:?--repo-root requires a value}" && pwd)"
      shift 2
      ;;
    --repo-writable)
      repo_mode="rw"
      shift
      ;;
    --cache-dir)
      cache_dir="$(mkdir -p "${2:?--cache-dir requires a value}" && cd "$2" && pwd)"
      shift 2
      ;;
    --user)
      container_user="${2:?--user requires a value}"
      shift 2
      ;;
    --current-user)
      container_user="$(id -u):$(id -g)"
      shift
      ;;
    --no-config-mounts)
      config_mounts=0
      shift
      ;;
    --mount)
      extra_mounts+=("${2:?--mount requires a value}")
      shift 2
      ;;
    --env)
      extra_env+=("${2:?--env requires a value}")
      shift 2
      ;;
    --no-tty)
      tty=0
      shift
      ;;
    --wrapper-help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -eq 0 ]]; then
  set -- --help
fi

if [[ "$config_mounts" != "0" ]]; then
  config_path="$(find_cli_config_path "$@")"
  if [[ -n "$config_path" ]]; then
    mount_output="$(resolve_config_mounts "$config_path")"
    while IFS= read -r mount_spec; do
      [[ -n "$mount_spec" ]] && auto_mounts+=("$mount_spec")
    done <<< "$mount_output"
  fi
fi

mkdir -p "$cache_dir" "$cache_dir/home" "$cache_dir/xdg" "$cache_dir/matplotlib" "$cache_dir/numba" "$cache_dir/pycache"

cmd=("$container_cli" run --rm)
if [[ "$tty" -eq 1 && -t 0 ]]; then
  cmd+=("-i")
fi
if [[ "$tty" -eq 1 && -t 1 ]]; then
  cmd+=("-t")
fi

cmd+=(
  -v "$repo_root:$repo_root:$repo_mode"
  -w "$repo_root"
  -v "$cache_dir:/tmp/axon-recon-cache:rw"
  -e AXON_RECON_CACHE_ROOT=/tmp/axon-recon-cache
  -e HOME=/tmp/axon-recon-cache/home
  -e XDG_CACHE_HOME=/tmp/axon-recon-cache/xdg
  -e MPLCONFIGDIR=/tmp/axon-recon-cache/matplotlib
  -e NUMBA_CACHE_DIR=/tmp/axon-recon-cache/numba
  -e PYTHONPYCACHEPREFIX=/tmp/axon-recon-cache/pycache
)

if [[ -n "$container_user" ]]; then
  cmd+=(--user "$container_user")
fi

for mount_spec in "${auto_mounts[@]}"; do
  cmd+=(-v "$mount_spec")
done
for mount_spec in "${extra_mounts[@]}"; do
  cmd+=(-v "$mount_spec")
done
for env_spec in "${extra_env[@]}"; do
  cmd+=(-e "$env_spec")
done

cmd+=("$image" "$@")

if [[ "$dry_run" -eq 1 ]]; then
  printf 'Resolved container command:\n'
  printf '%q ' "${cmd[@]}"
  printf '\n'
  exit 0
fi

exec "${cmd[@]}"