# Universal config for all debug scripts in this folder.
#
# How it works:
# - Each script loads this file (default) and uses these values as defaults.
# - CLI args override these values.
# - You can also export env vars in your shell to override (higher priority than file).

# --- Paths (required) ---
AXON_RECON_H5_PATH=/home/adamm/dev/symlinks/local_RBS_data/raw_data/Media_Density_T3_07012025_AR/Media_Density_T3_07012025_AR/250728/M07137/AxonTracking/000225/data.raw.h5
AXON_RECON_STREAM_ID=well003
AXON_RECON_MEA_OUTPUT_ROOT=/home/adamm/dev/symlinks/local_RBS_data/outputs

# If you don't have these installed as packages, point these at the repos.
AXON_RECON_MEA_ANALYSIS_REPO_ROOT=/home/adamm/dev/pkgs/MEA_Analysis
AXON_RECON_AXON_VELOCITY_REPO_ROOT=/home/adamm/dev/pkgs/axon_velocity

# --- Global toggles ---
AXON_RECON_DEBUG=0
AXON_RECON_FORCE_RESTART=0
AXON_RECON_FORCE_REPLOT=0
AXON_RECON_BREAK_BEFORE_RUN=0

# --- Cross-well analysis (projects/cross_well_analysis.py) ---
# Which plot sets to generate for the cross-well summary deck.
# Options: raw | clean | both
AXON_RECON_CROSS_WELL_PLOT_SOURCES=both

# Outlier handling for significance tests (plots always *highlight* outliers).
# If enabled, Mann–Whitney U tests run on inliers only (IQR rule per group).
AXON_RECON_CROSS_WELL_EXCLUDE_OUTLIERS_IN_TESTS=1
AXON_RECON_CROSS_WELL_OUTLIER_IQR_K=1.5

# Unit selection (used by templates/reconstruction/analysis)
AXON_RECON_UNIT_LIMIT=none
# AXON_RECON_UNIT_IDS=128

# --- Preprocessing ---
AXON_RECON_N_JOBS=24

# Uncomment to enable temporal resampling at the preprocessing stage (before spikesorting).
# Generally, dont recommend doing this, since spikesorters can typically handle the native sampling rate just fine, 
# and resampling can introduce its own issues. But if you want to experiment with it for debugging:
# AXON_RECON_TEMPORAL_RESAMPLE_FACTOR=10
# AXON_RECON_TEMPORAL_RESAMPLE_RATE_HZ=200000
# AXON_RECON_TEMPORAL_RESAMPLE_MARGIN_MS=100.0
# AXON_RECON_TEMPORAL_RESAMPLE_DTYPE=float32

# --- Spikesorting ---
AXON_RECON_SORTER=kilosort4
AXON_RECON_DOCKER_IMAGE=adammwea/benshalomlab_spikesorter_pythonpatch:v3

# Analyzer rerun / optional post-sorting unit merge (default off)
# - RERUN_ANALYZER recomputes spikesorting_outputs/analyzer_output even if checkpoints say complete.
# - FORCE_MERGE_ON_RESUME is testing-only: it forces merge phase execution on
#   resume by rerunning MEA analyzer pipeline steps.
# - AUTO_MERGE_UNITS runs SpikeInterface auto_merge_units after sorting and before reports.
AXON_RECON_SPIKESORT_RERUN_ANALYZER=0
AXON_RECON_SPIKESORT_FORCE_MERGE_ON_RESUME=0
AXON_RECON_SPIKESORT_AUTO_MERGE_UNITS=1
AXON_RECON_SPIKESORT_AUTO_MERGE_TEMPLATE_DIFF_THRESH=0.05,0.15,0.25 #these are the default values used by auto_merge_units; adjust as needed if you enable merging.
# Ensure experimental 4x4 post-merge is disabled unless explicitly overridden per-run.
AXON_RECON_SPIKESORT_POST_MERGE_4X4=0

# If curation is enabled but results in 0 curated units, you'll see:
# - waveforms_outputs/grids/uncurated.pdf exists
# - waveforms_outputs/grids/curated.pdf missing
# - templates_summary.json shows n_curated_units=0 and units=[]
# Disable curation to keep uncurated units for downstream debugging.
AXON_RECON_SPIKESORT_CURATION=1

# Resource knobs
AXON_RECON_CHUNK_DURATION=1s
AXON_RECON_TORCH_THREADS=1
AXON_RECON_TORCH_INTEROP_THREADS=1
AXON_RECON_OMP_THREADS=1
AXON_RECON_MKL_THREADS=1
AXON_RECON_OPENBLAS_THREADS=1
AXON_RECON_NUMEXPR_THREADS=1
# AXON_RECON_CUDA_VISIBLE_DEVICES=0

# Kilosort4 tuning
AXON_RECON_KS_BATCH_DURATION_S=0.75
# AXON_RECON_KS_BATCH_SIZE=

# Kilosort4 sensitivity tuning (passed through axon_reconstructor -> MEA_Analysis -> SpikeInterface run_sorter).
# These are not explicitly set by MEA_Analysis by default; when unset, Kilosort4 defaults apply.
# Reference values seen in current run artifact:
#   Th_universal=9, Th_learned=8, Th_single_ch=6,
#   cluster_downsampling=20, nearest_chans=10, max_channel_distance=32
# First-pass relaxed values to increase spike detection:
# Th_universal: global detection threshold for universal templates.
# Lower => accepts weaker events => less strict / more sensitive (but more potential noise).
AXON_RECON_KS_TH_UNIVERSAL=8
# Th_learned: detection threshold for learned templates.
# Lower => more spikes assigned to learned templates => less strict / more sensitive.
AXON_RECON_KS_TH_LEARNED=7
# Th_single_ch: threshold for single-channel candidate detections.
# Lower => more single-channel/low-amplitude events considered => less strict / more sensitive.
AXON_RECON_KS_TH_SINGLE_CH=5

# Secondary relaxation knobs (use with care; may increase false positives):
# cluster_downsampling: subsampling factor used in clustering.
# Lower => uses more spikes during clustering => can recover weaker/sparser units (higher compute).
AXON_RECON_KS_CLUSTER_DOWNSAMPLING=15
# nearest_chans: number of neighboring channels considered around a detection/template.
# Higher => allows broader spatial support => more permissive for spread waveforms.
AXON_RECON_KS_NEAREST_CHANS=12
# max_channel_distance: max spatial radius (in channel-distance units) for channel/template association.
# Higher => allows farther channels to contribute => more permissive spatial matching.
AXON_RECON_KS_MAX_CHANNEL_DISTANCE=40

# --- Waveforms ---
AXON_RECON_WF_MS_BEFORE=1
AXON_RECON_WF_MS_AFTER=2
AXON_RECON_WF_MAX_SPIKES_PER_UNIT=1000000
AXON_RECON_WF_PER_SEGMENT=1
# Default in waveforms stage is True; set to 0 temporarily to disable edge filtering.
AXON_RECON_WF_FILTER_BY_MAXWELL_EPOCHS=0
# Default is True; set to 0 to keep spikes even when waveform window crosses
# per-segment start/end bounds (debug sensitivity mode).
AXON_RECON_WF_FILTER_BY_SEGMENT_BOUNDS=0
AXON_RECON_WF_DEBUG_MAX_UNITS=
AXON_RECON_WF_DEBUG_MAX_SEGMENTS=
# Ensure waveforms stage does NOT read merged 4x4 spikesorting outputs by default.
AXON_RECON_WF_USE_MERGED_SPIKESORTING_4X4=0

# --- Footprinting/Templates ---
AXON_RECON_INCLUDE_CONCAT=1
AXON_RECON_INCLUDE_SEGMENTS=1
AXON_RECON_FOOTPRINT_UNIT_LIMIT=1000
AXON_RECON_FOOTPRINT_PLOT_CONCAT_GRID=1
AXON_RECON_FOOTPRINT_PLOT_MULTI_SOURCE=1
AXON_RECON_TEMPLATES_UNIT_LIMIT=none
AXON_RECON_TEMPLATES_TOP_CHANNELS_PER_TEMPLATE=0
AXON_RECON_TEMPLATES_PLOT_GRID_PDF=1
AXON_RECON_TEMPLATES_PLOT_MULTI_SOURCE_PDF=1
AXON_RECON_TEMPLATES_REPLOT_FROM_DISK=0

# Optional: upsample persisted templates along the time axis (post-spikesort).
# Factor=1 disables. Method: "sinc" (preferred; uses scipy resample_poly) or "linear".
AXON_RECON_TEMPLATES_TIME_UPSAMPLE_FACTOR=10
AXON_RECON_TEMPLATES_TIME_UPSAMPLE_METHOD=sinc

# If enabled, templates runs only on curated units derived from spikesorting metrics.
# If spikesorting curation yields 0 units, set this to 0 (and/or pass AXON_RECON_UNIT_IDS).
AXON_RECON_TEMPLATES_REQUIRE_CURATED_UNITS=1

# --- Reconstruction ---
AXON_RECON_RECON_UNIT_LIMIT=1000
AXON_RECON_RECON_WRITE_UNIT_PDFS=1
AXON_RECON_RECON_WRITE_ALL_UNITS_OVERVIEW_PDF=1
# Top-density raw-branch footprint grid (enabled by default).
AXON_RECON_RECON_WRITE_TOP_DENSITY_GRID=1
# Use "all" (or none/null) to include all available units in the density grid ranking.
AXON_RECON_RECON_TOP_N_DENSITY_REQUESTED=all
# Optional variant routing for reconstruction inputs/outputs.
# Leave unset for standard (non-variant) flow.
AXON_RECON_RECON_TEMPLATES_VARIANT_NAME=
AXON_RECON_RECON_VARIANT_NAME=

# Grid debug overlays.
AXON_RECON_RECON_SHOW_DENSITY_SCALE_DEBUG_TEXT=0
AXON_RECON_RECON_SHOW_DENSITY_SCALE_GLOBAL_DEBUG_TEXT=0
AXON_RECON_RECON_SHOW_DENSITY_SCALE_LOCAL_DEBUG_TEXT=0

# If 1, reconstruction stage only replots top-density grid from existing outputs
# and does not run per-unit reconstruction.
AXON_RECON_RECON_REPLOT_TOP_DENSITY_GRID_ONLY=0

AXON_RECON_RECON_VERBOSE=0
AXON_RECON_RECON_WRITE_TEMPLATE_MOVIE_GIF=1

# --- AV (axon_velocity) params ---
# These env vars are *optional*; if unset, axon_velocity defaults apply.
# Precedence inside debug_reconstruction_step.py:
#   1) CLI --r2-threshold / --av-params / --av-params-json
#   2) AXON_RECON_AV_<PARAM> keys below
#   3) AXON_RECON_AV_PARAMS_JSON / AXON_RECON_AV_PARAMS_JSON_PATH
#   4) Script's built-in defaults (AXON_VELOCITY_PARAMS)

# Optional JSON overrides merged onto the AV params dict:
# AXON_RECON_AV_PARAMS_JSON={"r2_threshold": 0.75}
# AXON_RECON_AV_PARAMS_JSON_PATH=/path/to/av_params.json

# Defaults below are copied from:
#   axon_velocity.tracking_classes.GraphAxonTracking.default_params
#
# Notes on non-obvious params (high level):
# - *threshold* params control channel selection + branch acceptance.
# - *distance* params are in the same units as `locations` (typically microns for MEA layouts).
# - If you set values here, keep them as raw scalars (no inline "# comments" on the same line).

# --- Channel selection / preprocessing ---
# Upsampling factor used inside AV (separate from any earlier temporal upsampling you do in preprocessing).
# AXON_RECON_AV_UPSAMPLE=1
# AXON_RECON_AV_INIT_DELAY=0
# detect_threshold + detection_type determine which channels are even considered part of the spike.
# AXON_RECON_AV_DETECT_THRESHOLD=0.01
# AXON_RECON_AV_DETECTION_TYPE=relative
# Kurtosis threshold; channels with "spike-like" waveforms tend to have higher kurtosis.
# AXON_RECON_AV_KURT_THRESHOLD=0.3
# Optional pruning based on peak-time local variability.
# AXON_RECON_AV_PEAK_STD_THRESHOLD=null
# AXON_RECON_AV_PEAK_STD_DISTANCE=30
# If true, drops isolated selected channels that have no local support.
# AXON_RECON_AV_REMOVE_ISOLATED=true
# Require at least this many selected channels to proceed.
# AXON_RECON_AV_MIN_SELECTED_POINTS=30

# --- Graph/path building ---
# AXON_RECON_AV_MIN_PATH_LENGTH=100
# AXON_RECON_AV_MIN_PATH_POINTS=5
# After a branch point, keep only subpaths with at least this many points.
# AXON_RECON_AV_MIN_POINTS_AFTER_BRANCHING=3
# AXON_RECON_AV_MAX_DISTANCE_FOR_EDGE=300
# AXON_RECON_AV_MAX_DISTANCE_TO_INIT=200
# Limit outgoing edges per node.
# AXON_RECON_AV_N_NEIGHBORS=3

# --- Fit + splitting + outliers ---
# Primary branch acceptance threshold.
# AXON_RECON_AV_R2_THRESHOLD=0.9
# Robust outlier detection threshold in units of MAD of fit error.
# AXON_RECON_AV_MAD_THRESHOLD=8
# A heuristic to bias edge selection (distance vs amplitude).
# AXON_RECON_AV_INIT_AMP_PEAK_RATIO=0.2
# AXON_RECON_AV_EDGE_DIST_AMP_RATIO=0.3
# Penalize long jumps more strongly.
# AXON_RECON_AV_DISTANCE_EXP=2
# Split a branch if peak-time jumps exceed this.
# AXON_RECON_AV_MAX_PEAK_LATENCY_FOR_SPLITTING=0.5
# If r2 falls below this, AV will try to identify outliers.
# AXON_RECON_AV_R2_THRESHOLD_FOR_OUTLIERS=0.98
# Minimum tracking error to treat a point as an outlier.
# AXON_RECON_AV_MIN_OUTLIER_TRACKING_ERROR=50
# TheilSen max iterations (robust line fit).
# AXON_RECON_AV_THEILSEN_MAXITER=2000
# Radius used when excluding neighbors around an identified path.
# AXON_RECON_AV_NEIGHBOR_RADIUS=100
# Allow splitting paths during cleaning.
# AXON_RECON_AV_SPLIT_PATHS=true

# --- AV overrides (non-default) ---

# # Set 1: More permissive graph building (keep more branches/edges), but stricter path acceptance (longer paths, higher R2).
# # Uncomment/set values here to override the AV defaults above.
AXON_RECON_AV_MIN_POINTS_AFTER_BRANCHING=2
#AXON_RECON_AV_MAX_DISTANCE_TO_INIT=2000
#AXON_RECON_AV_R2_THRESHOLD=0.80
#AXON_RECON_AV_R2_THRESHOLD_FOR_OUTLIERS=0.70
AXON_RECON_AV_MIN_PATH_LENGTH=17.5
AXON_RECON_AV_MIN_PATH_POINTS=4
AXON_RECON_AV_MAX_PEAK_LATENCY_FOR_SPLITTING=0.25
AXON_RECON_AV_KURT_THRESHOLD=0.25

# More branching / more nodes per branch (graph connectivity)
AXON_RECON_AV_N_NEIGHBORS=8
#AXON_RECON_AV_MAX_DISTANCE_FOR_EDGE=800
AXON_RECON_AV_DISTANCE_EXP=1

# Keep more candidate nodes (less front-end pruning)
AXON_RECON_AV_REMOVE_ISOLATED=false
AXON_RECON_AV_DETECT_THRESHOLD=0.005
AXON_RECON_AV_MIN_SELECTED_POINTS=25

# Less cleanup / less outlier removal
AXON_RECON_AV_MAD_THRESHOLD=10
AXON_RECON_AV_MIN_OUTLIER_TRACKING_ERROR=200
AXON_RECON_AV_NEIGHBOR_RADIUS=50

# Splitting: keep enabled, but not overly aggressive.
AXON_RECON_AV_SPLIT_PATHS=true
AXON_RECON_AV_MAX_PEAK_LATENCY_FOR_SPLITTING=0.5

# Theilsen Max Iter warnings are common. Increasing to 8k for next run to see if it helps.
AXON_RECON_AV_THEILSEN_MAXITER=8000

# # Set 2: Balanced + robust (dense Maxwell HD-MEA geometry).
# # Goal: avoid degenerate/empty paths (split_paths crash) while still allowing branching.
# # Start here if you want “literature-ish” conservative tracking on a ~17.5 µm pitch array.
# (Uncomment this block and keep only one Set enabled at a time.)
# AXON_RECON_AV_DETECTION_TYPE=relative
# AXON_RECON_AV_DETECT_THRESHOLD=0.01
# AXON_RECON_AV_KURT_THRESHOLD=0.25
# AXON_RECON_AV_REMOVE_ISOLATED=false
# AXON_RECON_AV_MIN_SELECTED_POINTS=30

# AXON_RECON_AV_MAX_DISTANCE_TO_INIT=200
# AXON_RECON_AV_MAX_DISTANCE_FOR_EDGE=250
# AXON_RECON_AV_N_NEIGHBORS=8
# AXON_RECON_AV_DISTANCE_EXP=2

# AXON_RECON_AV_MIN_PATH_LENGTH=10
# AXON_RECON_AV_MIN_PATH_POINTS=3
# AXON_RECON_AV_MIN_POINTS_AFTER_BRANCHING=3

# AXON_RECON_AV_R2_THRESHOLD=0.85
# AXON_RECON_AV_R2_THRESHOLD_FOR_OUTLIERS=0.95
# AXON_RECON_AV_MAD_THRESHOLD=8
# AXON_RECON_AV_MIN_OUTLIER_TRACKING_ERROR=50
# AXON_RECON_AV_NEIGHBOR_RADIUS=100

# AXON_RECON_AV_SPLIT_PATHS=true
# AXON_RECON_AV_MAX_PEAK_LATENCY_FOR_SPLITTING=0.5




# --- Analysis ---
AXON_RECON_ANALYSIS_PREFER_CURATED_WAVEFORMS_PANELS=1

# Optional: BOTM validation metrics (off by default)
# Writes under <well_out_dir>/analysis_outputs/botm_validation/
AXON_RECON_ANALYSIS_BOTM_ENABLE=0
# Interpreted as the number of unit spike *events* to score.
AXON_RECON_ANALYSIS_BOTM_N_SPIKE=200
# Interpreted as the number of spike-free noise windows to sample.
AXON_RECON_ANALYSIS_BOTM_N_NOISE=2000
AXON_RECON_ANALYSIS_BOTM_SEED=0

# Sorter name used to load concat sorting output.
AXON_RECON_ANALYSIS_BOTM_SORTER=kilosort4

# Channel-level matching (Figure-5-style validation)
# A channel is considered a "good match" iff its match fraction is STRICTLY > this threshold.
AXON_RECON_ANALYSIS_BOTM_CHANNEL_MATCH_FRACTION_THRESHOLD=0.70

# Prior probability p(signal) used in the analytic threshold for botm_franke2015.
# Must be in (0,1). For "known candidate event" comparisons, 0.5 is a reasonable default.
AXON_RECON_ANALYSIS_BOTM_CHANNEL_MATCH_PRIOR_SIGNAL=0.5
