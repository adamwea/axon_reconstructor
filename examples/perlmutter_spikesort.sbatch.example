#!/bin/bash
# Example NERSC Perlmutter sbatch script: GPU spikesort.sort under Shifter.
#
# Status: documentation. NERSC validation is DEFERRED per
# debug/guardrails/container_mpi4py_NERSC_optimization_guardrails.md.
#
# GPU contention rule (container_shifter_shape_plan.md §6, implemented as
# SpikesortGpuOversubscriptionError): Kilosort4 cannot safely share a single
# CUDA device across processes. When MPI/Slurm ranks exceed the NVML-reported
# physical GPU count, run_spikesort_stage raises before any CUDA allocation.
# Hence `-n 1` (one task per GPU node) for the sort stage in stage-split jobs.
# Multi-rank GPU sort would require either MPS or strictly one rank per
# physical GPU per node; neither is wired up here.
#
# Vocabulary mapping is the same as the CPU preprocess script
# (perlmutter_preprocess.sbatch.example).
#
# Stage-split rationale: keep this script narrowly scoped to the GPU-bound
# phase. CPU preprocess multi-rank → CPU reconstruct multi-rank should live in
# the preprocess sbatch (or sibling scripts), not in the GPU job.

#SBATCH --job-name=axon-spikesort
#SBATCH --account=<NERSC_ACCOUNT>
#SBATCH --constraint=gpu
#SBATCH --qos=regular
#SBATCH --time=04:00:00
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-task=1
#SBATCH --cpus-per-task=16
#SBATCH --image=<registry>/<image>:<tag>
#SBATCH --module=gpu,cuda-mpich
#SBATCH --volume="/global/cfs/<path/to/data>:/data:ro"
#SBATCH --volume="/global/cfs/<path/to/scratch>:/scratch:rw"

set -euo pipefail
export MPICH_GPU_SUPPORT_ENABLED=1

# Single-rank sort. Even though --task-backend slurm is passed, SLURM_NTASKS=1
# at runtime means the partition gate hands the rank everything (it's the only
# rank). The GPU contention check inside run_spikesort_stage stays inert because
# ranks (1) <= visible GPU count (1).
srun --cpu-bind=cores \
  shifter axon-reconstructor stages spikesort.sort \
    --config /data/debug.runtime.yml \
    --task-backend slurm \
    --tasks-per-node ${SLURM_NTASKS_PER_NODE} \
    --cpus-per-task ${SLURM_CPUS_PER_TASK} \
    --bind physical_cores
